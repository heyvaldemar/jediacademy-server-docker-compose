# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# Anyone with this can run any command on the server. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
#
# Rendered into the server config at start; the tracked cfg/server.cfg holds
# a placeholder and never the value.
JKA_SERVER_RCON_PASSWORD=

# ---------------------------------------------------------------- networking
# One UDP port for game, query and rcon, published under the number it binds.
# Players add host:port to their favourites; the original master server is
# gone, so the browser will not find you.
JKA_SERVER_PORT=29070

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull. The server name, the
# game type, the bot count and the map rotation live in cfg/server.cfg.
#
# JKA_SERVER_IMAGE_VERSION=latest@sha256:...
# JKA_SERVER_IMAGE_TAG=tiffi/jka-japlus:latest
#
# The server is resident at 51 MB; the 2.4 GB once recorded as its peak was
# the pk3 files in the page cache. 3g leaves that room and still bounds it.
# JKA_SERVER_MEMORY_LIMIT=3g
# JKA_SERVER_CPU_LIMIT=1.0
# JKA_SERVER_MEMORY_RESERVATION=128m
# JKA_SERVER_CPU_RESERVATION=0.25
#
# JKA_SERVER_START_PERIOD=60s
# JKA_SERVER_STOP_GRACE_PERIOD=15s
# JKA_SERVER_LOG_MAX_SIZE=10m
# JKA_SERVER_LOG_MAX_FILE=3
